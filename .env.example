# Gmail: create an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification). Use it below, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
ALERT_TO=you@gmail.com

# Optional: push alerts via the ntfy app (https://ntfy.sh). Use a long random topic name.
NTFY_TOPIC=
